# Optional. Canonical origin for social previews / OpenGraph URLs.
# Leave unset on Vercel: the app auto-detects VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL.
# Set it only for a custom domain, e.g. https://coursebuddy.com
NEXT_PUBLIC_SITE_URL=

# ── Supabase (required for /admin panel) ─────────────────────────
# Get these from Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# After creating a Supabase project, run supabase/migrations/001_courses_and_categories.sql
# in the SQL Editor, then create an admin user under Authentication → Users.
